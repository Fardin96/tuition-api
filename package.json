{
  "name": "tution-api",
  "version": "1.0.0",
  "description": "tution-media backend",
  "main": "dist/server.js",
  "type": "module",
  "author": "farabi",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup src/server.ts src/cron/weekly-location-expiry.ts src/cron/fee-reminders.ts src/cron/payment-reconcile.ts src/cron/file-cleanup.ts --format esm --out-dir dist --clean",
    "start": "node dist/server.js",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/index.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "lint:sql": "squawk --config .squawk.toml --no-error-on-unmatched-pattern prisma/migrations/*/migration.sql",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "openapi:export": "tsx --env-file-if-exists=.env src/openapi/export.ts",
    "openapi:check": "tsx --env-file-if-exists=.env src/openapi/export.ts --check",
    "test": "vitest",
    "test:ci": "vitest run",
    "cron:weekly-location-expiry": "tsx --env-file-if-exists=.env src/cron/weekly-location-expiry.ts",
    "cron:fee-reminders": "tsx --env-file-if-exists=.env src/cron/fee-reminders.ts",
    "cron:payment-reconcile": "tsx --env-file-if-exists=.env src/cron/payment-reconcile.ts",
    "sslc:smoke": "tsx --env-file-if-exists=.env scripts/sslc-smoke.ts",
    "cron:file-cleanup": "tsx --env-file-if-exists=.env src/cron/file-cleanup.ts",
    "r2:smoke": "tsx --env-file-if-exists=.env scripts/r2-smoke.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/lib-storage": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/etag": "^6.2.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "5.2.6",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "prisma": "7",
    "sslcommerz-lts": "1.2.0",
    "tsup": "^8.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "husky": "^9.1.7",
    "squawk-cli": "^2.72.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
