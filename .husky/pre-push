#!/bin/sh
set -e

echo "Running pre-push checks..."

if [ -z "$TEST_DATABASE_URL" ]; then
  echo ""
  echo "TEST_DATABASE_URL is not set. Set it before pushing, or skip the hook with:"
  echo "  git push --no-verify"
  echo ""
  exit 1
fi

yarn lint
yarn typecheck
yarn test:ci
yarn build

echo "Pre-push checks passed."
