#!/bin/sh
set -e

echo "Running pre-push checks..."

# Load .env if it exists so DATABASE_URL/TEST_DATABASE_URL are available.
if [ -f .env ]; then
  export $(grep -v '^#' .env | grep -v '^$' | xargs)
fi

if [ -z "$DATABASE_URL" ] && [ -z "$TEST_DATABASE_URL" ]; then
  echo ""
  echo "Neither DATABASE_URL nor TEST_DATABASE_URL is set. Add one to .env,"
  echo "export it in your shell, or skip the hook with:"
  echo "  git push --no-verify"
  echo ""
  exit 1
fi

if git rev-parse --verify -q origin/main >/dev/null && [ -n "$(git diff --name-only origin/main...HEAD -- prisma/migrations)" ]; then
  want=$(find prisma/migrations -name migration.sql | LC_ALL=C sort | xargs shasum -a 256 | shasum -a 256 | cut -d' ' -f1)
  if [ "$(cat .backups/.rehearsed 2>/dev/null)" != "$want" ]; then
    echo "Migrations changed since last rehearsal. Run: bash scripts/migrate-safe.sh '<prod direct url>' (or git push --no-verify)"
    exit 1
  fi
fi

yarn lint
yarn typecheck
yarn test:ci
yarn build

echo "Pre-push checks passed."
