}

enum FeeType {
  PLACEMENT
  RECURRING
  OTHER
}

// Set by a trigger from the payment rows (except WAIVED / VOID, which an admin sets).
// OVERDUE is not stored: (status in DUE, PARTIAL) and due_date < today.
enum FeeStatus {
  DUE
  PARTIAL
  PAID
  WAIVED
  VOID
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BANK
  CASH
  SSLCOMMERZ
  OTHER
}

enum PaymentKind {
  PAYMENT
  REVERSAL
}

// Lifecycle of one SSLCommerz checkout (payment_attempt). Table rules live in prisma/constraints.sql.
enum PaymentAttemptStatus {
  // Session created, waiting for the gateway.
  PENDING
  // Validated and posted to the ledger (payment_id set).
  SUCCEEDED
  // Soft end states. A later validated gateway success still moves them on.
  FAILED
  CANCELLED
  EXPIRED
  // Gateway says paid, but amount, currency, tran_id or risk do not match. No ledger row.
  REVIEW
  // Gateway took the money but the ledger refused it (fee waived/void, already paid, overpay). Needs an admin refund.
  UNAPPLIED
}

// Promo codes on tutor fees. A code takes a percent (optionally capped) or a flat amount off.
// Lifecycle of a refund of an SSLCommerz payment (payment_refund).
enum RefundStatus {
  // A tutor asked; waiting for a super admin.
  REQUESTED
  // A super admin said no. Nothing was sent to the gateway.
  REJECTED
  // Sent to the gateway and accepted; waiting for the gateway to finish.
  PROCESSING
  // The gateway refunded it. A REVERSAL ledger row is written when the payment was on the ledger.
  SUCCEEDED
  // The gateway refused or cancelled it. No money moved.
  FAILED
  // The outcome is unknown (timeout, crash mid-call). A person checks the merchant panel.
  NEEDS_REVIEW
}

enum RefundSource {
  TUTOR
  ADMIN
}

enum PromoDiscountType {
  PERCENT
  FLAT
}

// ACTIVE redemptions count toward a code's limits. RELEASED ones (code removed, fee voided) do not.
enum PromoRedemptionStatus {
  ACTIVE
  RELEASED
}

enum FilePurpose {
  STUDENT_ID
  TUTOR_ID
  CREDENTIAL
  TUTOR_VIDEO
  BLOG_COVER
}

enum FileStatus {
  PENDING_UPLOAD
  UPLOADED
  DELETED
}

enum ReportCategory {
  ABUSE
  FAKE_PROFILE
  SPAM
  NO_SHOW
  OFF_PLATFORM_CONTACT
  INAPPROPRIATE_CONTENT
  OTHER
}

enum DisputeType {
  NO_SHOW
  QUALITY
  PAYMENT
  SCHEDULE
  OTHER
}

enum CaseStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationEvent {
  APPLICATION_RECEIVED
  APPLICATION_CONFIRMED
  TUTOR_VERIFICATION_DECIDED
  PAYMENT_REMINDER
  ZONE_LIMIT_DECIDED
}

enum GeogSource {
  PIN
  PLACES
}

enum ZoneLimitRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// In-app alerts for the dashboard bell. Not delivered anywhere else.
enum AppNotificationKind {
  APPLICATION_RECEIVED
  PACKAGE_REQUESTED
  APPLICATION_ACCEPTED
  APPLICATION_DECLINED
  LISTING_FILLED // auto-declined because another applicant was accepted
  APPLICATION_WITHDRAWN
  APPLICATION_REOPENED
  APPLICATION_CANCELLED
  APPLICATION_COMPLETED
  PACKAGE_UPDATED // the tutor edited a package the student has a pending or confirmed request on
  PACKAGE_CLOSED // the tutor closed a package; pending requests expired
  // Upload moderation. These have no application; the note is set only when the admin shared it.
  ID_APPROVED
  ID_REJECTED
  VIDEO_APPROVED
  VIDEO_REJECTED
  FILE_REMOVED // file_purpose says which upload
  UPLOADS_BLOCKED // blocks_videos / blocks_documents say what is paused
  UPLOADS_UNBLOCKED
  // A student invited the tutor to apply. Carries requirement_id, not application_id.
  REQUIREMENT_INVITED
}

// What an admin did to a user's upload, kept after the file itself is gone.
enum UploadReviewAction {
  APPROVED
  REJECTED
  REVOKED // an approved ID set back to rejected
  REMOVED // the file was deleted from storage
  BLOCKED // uploads paused (no file)
  UNBLOCKED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  DEAD
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Education model: labels and the curriculum/level/group rules live in src/lib/education.ts.
enum Curriculum {
  BANGLA_MEDIUM
  ENGLISH_VERSION
  EM_CAMBRIDGE
  EM_EDEXCEL
  EM_IB
  EM_AMERICAN
  MADRASAH
}

enum AcademicGroup {
  SCIENCE
  BUSINESS
  HUMANITIES
  MUJABBID
}

// Exam streams, not university clusters (clusters change every year).
enum AdmissionTarget {
  ENGINEERING
  MEDICAL
  VARSITY_SCIENCE
  VARSITY_HUMANITIES
  VARSITY_BUSINESS
  AGRICULTURE
  IBA_BUP
  PRIVATE_UNI
  ABROAD_TESTS
  ISSB
