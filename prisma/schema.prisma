// ───────────────────────── accounts & admin ─────────────────────────
// Login = short-lived access token + a refresh token kept in `session` (hash
// only). OTP codes live hashed in phone_otp. Consent is two columns on
// account, not a log table.
// One account = one role = at most one profile: each profile row carries a
// fixed `role` and a composite FK (account_id, role) -> account (id, role).

model Account {
  id                String        @id @default(uuid(7)) @db.Uuid
  role              Role
  googleSub         String        @unique @map("google_sub")
  email             String        @unique // lowercased
  status            AccountStatus @default(ACTIVE) // BLOCKED is set by trigger from account_block
  consentVersion    String?       @map("consent_version")
  consentAcceptedAt DateTime?     @map("consent_accepted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(3)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)

  student         Student?
  tutor           Tutor?
  adminUser       AdminUser?
  sessions        Session[]
  files           FileAsset[]
  notifications   NotificationLog[]
  alerts          AppNotification[]
  auditEntries    AuditLog[]
  blocks          AccountBlock[]
  uploadReviews   UploadReview[]
  uploadBlocks    UploadBlock[]
  reportsMade     Report[]          @relation("ReportReporter")
  reportsAgainst  Report[]          @relation("ReportTarget")
  disputesRaised  Dispute[]         @relation("DisputeRaisedBy")
  disputesAgainst Dispute[]         @relation("DisputeAgainst")
  refundRequests  PaymentRefund[]
  phoneOtps       PhoneOtp[]

  @@unique([id, role]) // target of the profile composite FKs
  @@map("account")
}

// One row per signed-in device. The refresh token is opaque and random; only its
// SHA-256 hash is stored, never the token itself.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3) // refresh-token expiry
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip               String?
  userAgent        String?   @map("user_agent")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@index([expiresAt]) // cleanup job
  @@map("session")
}

// ADMIN: can moderate. SUPER_ADMIN: everything an admin can do, plus approve or
// remove admins and block accounts. Only two people can be SUPER_ADMIN
// (super_admin_email, two slots). New admins start PENDING until a super admin
// approves them.
model AdminUser {
  accountId    String      @id @map("account_id") @db.Uuid
  role         Role        @default(ADMIN)
  name         String
  adminRole    AdminRole   @default(ADMIN) @map("admin_role")
  status       AdminStatus @default(PENDING)
  approvedById String?     @map("approved_by") @db.Uuid
  approvedAt   DateTime?   @map("approved_at") @db.Timestamptz(3)
  removedById  String?     @map("removed_by") @db.Uuid
  removedAt    DateTime?   @map("removed_at") @db.Timestamptz(3)
  mfaEnabled   Boolean     @default(false) @map("mfa_enabled")
  mfaSecretEnc String?     @map("mfa_secret_enc") // encrypted at app level
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  account    Account     @relation(fields: [accountId, role], references: [id, role])
  approvedBy AdminUser?  @relation("AdminApproval", fields: [approvedById], references: [accountId], onDelete: Restrict)
  approvals  AdminUser[] @relation("AdminApproval")
  removedBy  AdminUser?  @relation("AdminRemoval", fields: [removedById], references: [accountId], onDelete: Restrict)
  removals   AdminUser[] @relation("AdminRemoval")

  reviewedVerifications TutorVerification[]
  reviewedStudents      Student[]           @relation("StudentVerificationReviewer")
  recordedPayments      FeePayment[]
  createdPromoCodes     PromoCode[]
  decidedRefunds        PaymentRefund[]
  blogPosts             BlogPost[]
  contentEdits          SiteContent[]
  blocksMade            AccountBlock[]      @relation("BlockedBy")
  unblocksMade          AccountBlock[]      @relation("UnblockedBy")
  uploadReviewsMade     UploadReview[]
  uploadBlocksMade      UploadBlock[]       @relation("UploadBlockedBy")
  uploadUnblocksMade    UploadBlock[]       @relation("UploadUnblockedBy")
  handledReports        Report[]
  handledDisputes       Dispute[]
  zoneRequestsDecided   ZoneLimitRequest[]
  settingsEdits         PlatformSetting[]

  @@unique([accountId, role])
  @@map("admin_user")
}

// The only emails allowed to hold SUPER_ADMIN. Two slots, seeded once.
model SuperAdminEmail {
  slot  Int    @id // 1 or 2
  email String @unique

  @@map("super_admin_email")
}

// A block is a super-admin action. History is kept; at most one block is active
// per account. A trigger keeps account.status in step.
model AccountBlock {
  id            String    @id @default(uuid(7)) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  blockedById   String    @map("blocked_by") @db.Uuid
  reason        String
  blockedAt     DateTime  @default(now()) @map("blocked_at") @db.Timestamptz(3)
  unblockedAt   DateTime? @map("unblocked_at") @db.Timestamptz(3)
  unblockedById String?   @map("unblocked_by") @db.Uuid

  account     Account    @relation(fields: [accountId], references: [id])
  blockedBy   AdminUser  @relation("BlockedBy", fields: [blockedById], references: [accountId])
  unblockedBy AdminUser? @relation("UnblockedBy", fields: [unblockedById], references: [accountId], onDelete: Restrict)

  @@index([accountId, blockedAt(sort: Desc)])
  @@map("account_block")
}

// Upload history per user: every admin decision on, or removal of, one of their uploads, and every
// upload block. File details are copied in, so a row outlives the file (file_id is then null).
// Append-only. Goes with the user's account; an admin's own deletion only clears actor_account_id.
model UploadReview {
  id             String             @id @default(uuid(7)) @db.Uuid
  accountId      String             @map("account_id") @db.Uuid // the uploader
  fileId         String?            @map("file_id") @db.Uuid
  purpose        FilePurpose?
  fileName       String?            @map("file_name")
  contentType    String?            @map("content_type")
  sizeBytes      Int?               @map("size_bytes")
  action         UploadReviewAction
  note           String?
  noteVisible    Boolean            @default(true) @map("note_visible")
  actorAccountId String?            @map("actor_account_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  file    FileAsset? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  actor   AdminUser? @relation(fields: [actorAccountId], references: [accountId], onDelete: SetNull)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([fileId])
  @@index([actorAccountId])
  @@map("upload_review")
}

// An admin pausing a user's uploads. At most one active row (unblocked_at null) per account
// (partial unique index upload_block_one_active); lifting it sets unblocked_at, so rows are history.
model UploadBlock {
  id              String    @id @default(uuid(7)) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  blocksVideos    Boolean   @map("blocks_videos")
  blocksDocuments Boolean   @map("blocks_documents") // IDs and certificates (images and PDFs)
  note            String
  noteVisible     Boolean   @default(true) @map("note_visible")
  blockedById     String?   @map("blocked_by") @db.Uuid
  blockedAt       DateTime  @default(now()) @map("blocked_at") @db.Timestamptz(3)
  unblockedAt     DateTime? @map("unblocked_at") @db.Timestamptz(3)
  unblockedById   String?   @map("unblocked_by") @db.Uuid

  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  blockedBy   AdminUser? @relation("UploadBlockedBy", fields: [blockedById], references: [accountId], onDelete: SetNull)
  unblockedBy AdminUser? @relation("UploadUnblockedBy", fields: [unblockedById], references: [accountId], onDelete: SetNull)

  @@index([accountId, blockedAt(sort: Desc)])
  @@index([blockedById])
  @@index([unblockedById])
  @@map("upload_block")
}

// ───────────────────────── lookups ─────────────────────────

// Division > district > area. Seeded, then edited by admins; inactive areas leave GET /areas.
model Area {
  id       Int     @id @default(autoincrement())
  division String
  district String
  name     String
  isActive Boolean @default(true) @map("is_active")

  students     Student[]
  tutorAreas   TutorArea[]
  requirements TuitionRequirement[]

  @@unique([district, name])
  @@map("area")
}

// The clean subject list (Math, English, Physics...). Admin-managed.
model Subject {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  slug                String               @unique
  sortOrder           Int                  @default(0) @map("sort_order")
  isActive            Boolean              @default(true) @map("is_active")
  tutorSubjects       TutorSubject[]
  requirementSubjects RequirementSubject[]

  @@map("subject")
}

// Every uploaded object. Other tables reference file_asset, never a raw URL.
model FileAsset {
  id             String      @id @default(uuid(7)) @db.Uuid
  ownerAccountId String      @map("owner_account_id") @db.Uuid
  purpose        FilePurpose
  storageKey     String      @unique @map("storage_key")
  contentType    String      @map("content_type")
  sizeBytes      Int         @map("size_bytes")
  status         FileStatus  @default(PENDING_UPLOAD)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt     DateTime?   @map("uploaded_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  // The name the uploader's device gave the file. Shown to admins; never used in the storage key.
  originalName   String?     @map("original_name")
  // Set while a copy sits in the public bucket under the same key (approved videos, blog covers).
  publishedAt    DateTime?   @map("published_at") @db.Timestamptz(3)

  owner                Account             @relation(fields: [ownerAccountId], references: [id])
  studentVerifications Student[]           @relation("StudentVerificationFile")
  tutorVerifications   TutorVerification[]
  credentials          TutorCredential[]
  videos               TutorVideo[]
  blogCovers           BlogPost[]
  reviews              UploadReview[]

  @@index([ownerAccountId])
  @@index([status, createdAt])
  @@map("file_asset")
}

// ───────────────────────── profiles ─────────────────────────

model Student {
  id                       String             @id @default(uuid(7)) @db.Uuid
  accountId                String             @unique @map("account_id") @db.Uuid
  role                     Role               @default(STUDENT)
  name                     String
  areaId                   Int                @map("area_id")
  address                  String
  emergencyContact         String             @map("emergency_contact")
  whatsappNumber           String?            @unique @map("whatsapp_number") // E.164 text, never numeric; optional
  whatsappVerifiedAt       DateTime?          @map("whatsapp_verified_at") @db.Timestamptz(3)
  phoneNumber              String             @unique @map("phone_number")
  phoneVerifiedAt          DateTime?          @map("phone_verified_at") @db.Timestamptz(3)
  studentIdNumber          String             @map("student_id_number")
  verificationFileId       String?            @map("verification_file_id") @db.Uuid
  verificationStatus       VerificationStatus @default(NOT_SUBMITTED) @map("verification_status")
  // The latest ID submission's review. A resubmission clears the decision fields.
  verificationSubmittedAt  DateTime?          @map("verification_submitted_at") @db.Timestamptz(3)
  verificationDecidedAt    DateTime?          @map("verification_decided_at") @db.Timestamptz(3)
  verificationReviewedById String?            @map("verification_reviewed_by") @db.Uuid
  verificationNote         String?            @map("verification_note")
  // False keeps the note between admins: the student sees a generic message instead.
  verificationNoteVisible  Boolean            @default(true) @map("verification_note_visible")
  // Rating tutors give this student. Written only by the review trigger.
  ratingAvg                Decimal            @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount              Int                @default(0) @map("rating_count")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  account                Account              @relation(fields: [accountId, role], references: [id, role])
  area                   Area                 @relation(fields: [areaId], references: [id])
  verificationFile       FileAsset?           @relation("StudentVerificationFile", fields: [verificationFileId], references: [id], onDelete: Restrict)
  verificationReviewedBy AdminUser?           @relation("StudentVerificationReviewer", fields: [verificationReviewedById], references: [accountId], onDelete: Restrict)
  requirements           TuitionRequirement[]
  applications           Application[]
  reviewsGiven           Review[]             @relation("ReviewStudent")
  location               StudentLocation?
  invitesSent            RequirementInvite[]

  @@unique([accountId, role])
  @@index([areaId])
  @@index([verificationStatus])
  @@map("student")
}

model Tutor {
  id                 String             @id @default(uuid(7)) @db.Uuid
  accountId          String             @unique @map("account_id") @db.Uuid
  role               Role               @default(TUTOR)
  name               String
  address            String
  emergencyContact   String?            @map("emergency_contact")
  whatsappNumber     String?            @unique @map("whatsapp_number")
  whatsappVerifiedAt DateTime?          @map("whatsapp_verified_at") @db.Timestamptz(3)
  phoneNumber        String             @unique @map("phone_number")
  phoneVerifiedAt    DateTime?          @map("phone_verified_at") @db.Timestamptz(3)
  studentIdNumber    String?            @map("student_id_number") // required only when submitting verification (#32)
  gender             Gender
  parentsInfo        String?            @map("parents_info")
  instituteName      String?            @map("institute_name") // university or college; 1-120 chars (API)
  zoneLimit          Int                @default(5) @map("zone_limit") @db.SmallInt
  // Denormalised current state, kept in step by trigger from tutor_verification (latest row).
  verificationStatus VerificationStatus @default(NOT_SUBMITTED) @map("verification_status")
  // Maintained by recompute_is_listed() (constraints.sql): account ACTIVE and, only when platform_setting require_tutor_verification is true, verification APPROVED. Never set by hand.
  isListed           Boolean            @default(false) @map("is_listed")
  // Rating students give this tutor. Written only by the review trigger.
  ratingAvg          Decimal            @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                @default(0) @map("rating_count")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  account       Account             @relation(fields: [accountId, role], references: [id, role])
  areas         TutorArea[]
  subjects      TutorSubject[]
  verifications TutorVerification[]
  credentials   TutorCredential[]
  videos        TutorVideo[]
  packages      TuitionPackage[]
  applications  Application[]
  fees          PlatformFee[]
  reviews       Review[]            @relation("ReviewTutor")
  location      TutorLocation?

  requirements      TutorRequirement[]
  zones             TutorZone[]
  zoneLimitRequests ZoneLimitRequest[]
  paymentAttempts   PaymentAttempt[]
  promoRedemptions  PromoRedemption[]
  refunds           PaymentRefund[]
  invites           RequirementInvite[]

  @@unique([accountId, role])
  @@index([isListed, ratingAvg(sort: Desc)])
  @@index([isListed, gender])
  @@map("tutor")
}

model TutorLocation {
  id             String                                @id @default(uuid(7)) @db.Uuid
  tutorId        String                                @unique @map("tutor_id") @db.Uuid
  placeId        String?                               @map("place_id")
  geogSource     GeogSource                            @default(PIN) @map("geog_source")
  addressText    String                                @map("address_text")
  districtCode   String                                @map("district_code")
  geog           Unsupported("GEOGRAPHY(POINT,4326)")?
  geogFetchedAt  DateTime?                             @map("geog_fetched_at") @db.Timestamptz(3)
  needsReaddress Boolean                               @default(false) @map("needs_readdress")
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([districtCode])
  @@map("tutor_location")
}

model StudentLocation {
  id             String                                @id @default(uuid(7)) @db.Uuid
  studentId      String                                @unique @map("student_id") @db.Uuid
  placeId        String?                               @map("place_id")
  geogSource     GeogSource                            @default(PIN) @map("geog_source")
  addressText    String                                @map("address_text")
  districtCode   String                                @map("district_code")
  geog           Unsupported("GEOGRAPHY(POINT,4326)")?
  geogFetchedAt  DateTime?                             @map("geog_fetched_at") @db.Timestamptz(3)
  needsReaddress Boolean                               @default(false) @map("needs_readdress")
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([districtCode])
  @@map("student_location")
}

// Areas a tutor teaches in (many).
model TutorArea {
  tutorId String @map("tutor_id") @db.Uuid
  areaId  Int    @map("area_id")

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  area  Area  @relation(fields: [areaId], references: [id])

  @@id([tutorId, areaId])
  @@index([areaId, tutorId])
  @@map("tutor_area")
}

// Subjects a tutor teaches (many), from the clean subject list.
model TutorSubject {
  tutorId   String @map("tutor_id") @db.Uuid
  subjectId Int    @map("subject_id")

  tutor   Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  requirementSubjects TutorRequirementSubject[]
  packageSubjects     PackageSubject[]

  @@id([tutorId, subjectId])
  @@index([subjectId, tutorId])
  @@map("tutor_subject")
}

// One row per submission. A rejection survives a later approved resubmission.
model TutorVerification {
  id           String             @id @default(uuid(7)) @db.Uuid
  tutorId      String             @map("tutor_id") @db.Uuid
  fileId       String             @map("file_id") @db.Uuid
  ocrData      Json?              @map("ocr_data")
  status       VerificationStatus @default(PENDING)
  submittedAt  DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedById String?            @map("reviewed_by") @db.Uuid
  decidedAt    DateTime?          @map("decided_at") @db.Timestamptz(3)
  note         String?
  // False keeps the note between admins: the tutor sees a generic message instead.
  noteVisible  Boolean            @default(true) @map("note_visible")

  tutor      Tutor      @relation(fields: [tutorId], references: [id])
  file       FileAsset  @relation(fields: [fileId], references: [id])
  reviewedBy AdminUser? @relation(fields: [reviewedById], references: [accountId], onDelete: Restrict)

  @@index([tutorId, submittedAt(sort: Desc)])
  @@index([status, submittedAt]) // admin review queue
  @@map("tutor_verification")
}

model TutorCredential {
  id        String @id @default(uuid(7)) @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid
  examLabel String @map("exam_label")
  result    String
  fileId    String @map("file_id") @db.Uuid

  tutor Tutor     @relation(fields: [tutorId], references: [id])
  file  FileAsset @relation(fields: [fileId], references: [id])

  @@index([tutorId])
  @@map("tutor_credential")
}

// Needs admin approval before it shows. Curated: top tutors only (20-50 total).
model TutorVideo {
  id             String           @id @default(uuid(7)) @db.Uuid
  tutorId        String           @map("tutor_id") @db.Uuid
  fileId         String           @unique @map("file_id") @db.Uuid
  title          String
  status         ModerationStatus @default(PENDING)
  moderationNote String?          @map("moderation_note")
  // False keeps the note between admins: the tutor sees a generic message instead.
  noteVisible    Boolean          @default(true) @map("note_visible")
  sortOrder      Int              @default(0) @map("sort_order")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tutor Tutor     @relation(fields: [tutorId], references: [id])
  file  FileAsset @relation(fields: [fileId], references: [id])

  @@index([tutorId])
  @@index([status, sortOrder])
  @@map("tutor_video")
}

// Tutor-side constraint set. The mirror of TuitionRequirement, used for matching.
model TutorRequirement {
  id               String            @id @default(uuid(7)) @db.Uuid
  tutorId          String            @map("tutor_id") @db.Uuid
  name             String            @db.VarChar(60) // tutor's label, e.g. "Evening Math, Mirpur"
  isDefault        Boolean           @default(false) @map("is_default")
  isActive         Boolean           @default(true) @map("is_active") // archive instead of delete
  levelMin         Int               @map("level_min") @db.SmallInt // -4..13, age order
  levelMax         Int               @map("level_max") @db.SmallInt
  curricula        Curriculum[] // at least one
  academicGroups   AcademicGroup[]   @default([]) @map("academic_groups") // empty = any group
  admissionTargets AdmissionTarget[] @default([]) @map("admission_targets") // empty = any target
  timeFrom         DateTime          @map("time_from") @db.Time(0)
  timeTo           DateTime          @map("time_to") @db.Time(0)
  availableDays    Int               @default(127) @map("available_days") @db.SmallInt // bit0=Sat ... bit6=Fri
  daysPerWeek      Int?              @map("days_per_week") @db.SmallInt // 1..7; null = any number of the available days
  minSalary        Int?              @map("min_salary") // BDT/month floor; null = no floor
  maxStudents      Int               @default(1) @map("max_students") @db.SmallInt
  availableFrom    DateTime          @map("available_from") @db.Date
  teachesOnline    Boolean           @default(false) @map("teaches_online")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutor    Tutor                     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subjects TutorRequirementSubject[]
  zones    TutorRequirementZone[]

  @@unique([id, tutorId]) // target of the composite FKs below
  @@index([tutorId, isActive])
  @@map("tutor_requirement")
}

// Subjects of a constraint set. The composite FK to tutor_subject makes
// "set subjects must be a subset of profile subjects" a database guarantee.
model TutorRequirementSubject {
  requirementId String @map("requirement_id") @db.Uuid
  tutorId       String @map("tutor_id") @db.Uuid
  subjectId     Int    @map("subject_id")

  requirement  TutorRequirement @relation(fields: [requirementId, tutorId], references: [id, tutorId], onDelete: Cascade)
  tutorSubject TutorSubject     @relation(fields: [tutorId, subjectId], references: [tutorId, subjectId], onDelete: Cascade)

  @@id([requirementId, subjectId])
  @@index([subjectId, requirementId])
  @@map("tutor_requirement_subject")
}

// Teaching zone: a circle on the map. Quota per tutor = tutor.zone_limit.
model TutorZone {
  id          String                                @id @default(uuid(7)) @db.Uuid
  tutorId     String                                @map("tutor_id") @db.Uuid
  label       String                                @db.VarChar(60)
  // optional in Prisma only so the model stays creatable; NOT NULL is enforced in SQL (§2).
  // Always insert/update via $executeRaw with ST_SetSRID(ST_MakePoint(lng, lat), 4326)::geography.
  center      Unsupported("GEOGRAPHY(POINT,4326)")?
  radiusM     Int                                   @map("radius_m")
  placeId     String?                               @map("place_id")
  addressText String?                               @map("address_text")
  geogSource  GeogSource                            @default(PIN) @map("geog_source")
  createdAt   DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutor        Tutor                  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  requirements TutorRequirementZone[]
  packages     PackageZone[]

  @@unique([id, tutorId])
  @@index([tutorId])
  @@map("tutor_zone")
}

model TutorRequirementZone {
  requirementId String @map("requirement_id") @db.Uuid
  zoneId        String @map("zone_id") @db.Uuid
  tutorId       String @map("tutor_id") @db.Uuid

  requirement TutorRequirement @relation(fields: [requirementId, tutorId], references: [id, tutorId], onDelete: Cascade)
  zone        TutorZone        @relation(fields: [zoneId, tutorId], references: [id, tutorId], onDelete: Cascade)

  @@id([requirementId, zoneId])
  @@index([zoneId])
  @@map("tutor_requirement_zone")
}

// Tutor asks for a higher zone quota; admin approves or denies.
model ZoneLimitRequest {
  id             String                 @id @default(uuid(7)) @db.Uuid
  tutorId        String                 @map("tutor_id") @db.Uuid
  requestedLimit Int                    @map("requested_limit") @db.SmallInt
  reason         String
  status         ZoneLimitRequestStatus @default(PENDING)
  decidedById    String?                @map("decided_by") @db.Uuid
  decidedAt      DateTime?              @map("decided_at") @db.Timestamptz(3)
  decisionNote   String?                @map("decision_note")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  tutor     Tutor      @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  decidedBy AdminUser? @relation(fields: [decidedById], references: [accountId], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([tutorId, createdAt(sort: Desc)])
  @@map("zone_limit_request")
}

// ───────────────────────── listings ─────────────────────────

// A student's search criteria: used as a filter to find tutors, and visible to
// tutors who may apply. A student can have any number. No admin approval.
model TuitionRequirement {
  id               String            @id @default(uuid(7)) @db.Uuid
  studentId        String            @map("student_id") @db.Uuid
  areaId           Int?              @map("area_id") // where the tuition happens
  levelCode        Int?              @map("level_code") @db.SmallInt // -4..13; null only on drafts
  curriculum       Curriculum? // null only on drafts
  academicGroup    AcademicGroup?    @map("academic_group") // levels 9-12 only
  admissionTargets AdmissionTarget[] @default([]) @map("admission_targets") // level 13 only
  isRetaker        Boolean           @default(false) @map("is_retaker") // levels 10, 12, 13 only
  levelNote        String?           @map("level_note") // max 40 chars (CHECK); display only, never matched
  timeOfDay        DateTime?         @map("time_of_day") @db.Time(0)
  daysPerWeek      Int?              @map("days_per_week") @db.SmallInt
  availableDays    Int               @default(127) @map("available_days") @db.SmallInt // bit0=Sat ... bit6=Fri
  salary           Int? // BDT per month
  studentCount     Int?              @default(1) @map("student_count") @db.SmallInt
  hireByDate       DateTime?         @map("hire_by_date") @db.Date
  tutorGenderPref  GenderPref        @default(ANY) @map("tutor_gender_pref")
  instituteName    String?           @map("institute_name")
  tuitionType      String?           @map("tuition_type") @db.VarChar(30)
  status           ListingStatus     @default(OPEN)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  student      Student              @relation(fields: [studentId], references: [id])
  area         Area?                @relation(fields: [areaId], references: [id], onDelete: Restrict)
  subjects     RequirementSubject[]
  applications Application[]
  invites      RequirementInvite[]
  alerts       AppNotification[]

  @@index([studentId, createdAt(sort: Desc)])
  @@index([status, curriculum, levelCode, areaId, createdAt(sort: Desc)])
  @@map("tuition_requirement")
}

// Join table for TuitionRequirement <-> Subject (many-to-many)
model RequirementSubject {
  requirementId String @map("requirement_id") @db.Uuid
  subjectId     Int    @map("subject_id")

  requirement TuitionRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([requirementId, subjectId])
  @@index([subjectId, requirementId])
  @@map("requirement_subject")
}

// A student asks a tutor to apply to one of their OPEN requirements. The tutor then applies as usual;
// the invite never creates an application. One per (requirement, tutor).
model RequirementInvite {
  id            String   @id @default(uuid(7)) @db.Uuid
  requirementId String   @map("requirement_id") @db.Uuid
  tutorId       String   @map("tutor_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  requirement TuitionRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  tutor       Tutor              @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([requirementId, tutorId])
  @@index([tutorId, createdAt(sort: Desc)])
  @@index([studentId])
  @@map("requirement_invite")
}

// The hard limit for home tuition (see src/modules/matching/). Created by migration 20261128000100_matching,
// which seeds Dhaka. boundary is optional in Prisma only; NOT NULL is enforced in SQL, and it is written
// through raw SQL (ST_GeomFromGeoJSON). GIST index city_boundary_gix lives in SQL.
model City {
  slug         String                                       @id
  name         String
  districtCode String                                       @map("district_code")
  boundary     Unsupported("GEOGRAPHY(MULTIPOLYGON,4326)")?
  isActive     Boolean                                      @default(true) @map("is_active")
  createdAt    DateTime                                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("city")
}

// Created by a tutor. Needs admin approval before students can see it.
model TuitionPackage {
  id               String            @id @default(uuid(7)) @db.Uuid
  tutorId          String            @map("tutor_id") @db.Uuid
  // The offer: what the tutor will finish, how long it takes and what it costs in total.
  title            String            @db.VarChar(80)
  description      String            @db.VarChar(600)
  coverage         PackageCoverage
  durationWeeks    Int               @map("duration_weeks") @db.SmallInt // 1..104
  price            Int // BDT for the whole package; the placement fee is a percentage of it
  // Who and when, same fields and rules as a TutorRequirement set.
  levelMin         Int               @map("level_min") @db.SmallInt // -4..13, age order
  levelMax         Int               @map("level_max") @db.SmallInt
  curricula        Curriculum[] // at least one
  academicGroups   AcademicGroup[]   @default([]) @map("academic_groups") // empty = any group
  admissionTargets AdmissionTarget[] @default([]) @map("admission_targets") // empty = any target
  timeFrom         DateTime          @map("time_from") @db.Time(0)
  timeTo           DateTime          @map("time_to") @db.Time(0)
  availableDays    Int               @default(127) @map("available_days") @db.SmallInt // bit0=Sat ... bit6=Fri
  daysPerWeek      Int?              @map("days_per_week") @db.SmallInt // 1..7; null = any number of the available days
  maxStudents      Int               @default(1) @map("max_students") @db.SmallInt
  availableFrom    DateTime          @map("available_from") @db.Date
  teachesOnline    Boolean           @default(false) @map("teaches_online")
  status           ListingStatus     @default(OPEN)
  moderationStatus ModerationStatus  @default(PENDING) @map("moderation_status")
  moderationNote   String?           @map("moderation_note")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutor        Tutor            @relation(fields: [tutorId], references: [id])
  subjects     PackageSubject[]
  zones        PackageZone[]
  applications Application[]

  @@unique([id, tutorId]) // target of the composite FKs below
  @@index([tutorId, createdAt(sort: Desc)])
  @@index([status, moderationStatus, createdAt(sort: Desc)])
  @@map("tuition_package")
}

// Subjects of a package. The composite FK to tutor_subject keeps them a subset of profile subjects.
model PackageSubject {
  packageId String @map("package_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid
  subjectId Int    @map("subject_id")

  package      TuitionPackage @relation(fields: [packageId, tutorId], references: [id, tutorId], onDelete: Cascade)
  tutorSubject TutorSubject   @relation(fields: [tutorId, subjectId], references: [tutorId, subjectId], onDelete: Cascade)

  @@id([packageId, subjectId])
  @@index([subjectId, packageId])
  @@map("package_subject")
}

// Zones a package is taught in. Same composite-FK pattern as tutor_requirement_zone.
model PackageZone {
  packageId String @map("package_id") @db.Uuid
  zoneId    String @map("zone_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid

  package TuitionPackage @relation(fields: [packageId, tutorId], references: [id, tutorId], onDelete: Cascade)
  zone    TutorZone      @relation(fields: [zoneId, tutorId], references: [id, tutorId], onDelete: Cascade)

  @@id([packageId, zoneId])
  @@index([zoneId])
  @@map("package_zone")
}

// ───────────────────────── matching ─────────────────────────
// Two ways in:
//   A TUTOR applies to a student's requirement. Many tutors can apply to the
//   same requirement (one row per tutor). The STUDENT who posted it accepts or
//   rejects each tutor.
//   A STUDENT takes a tutor's package.
// No admin approval anywhere on applications, and admins do not accept or
// reject them. (Admin approval applies to tutor packages and videos.)
// Duplicates are impossible: one application per (tutor, requirement) and one
// per (student, package). To retry after a withdrawal, reopen the same row.
// A CONFIRMED / COMPLETED row is the hiring / tuition history record, and its
// confirmed_at / ended_at can never be changed (trigger).
// Ownership ("requirement is this student's, package is this tutor's") is
// enforced by application_target_guard (trigger), not by a composite FK.

model Application {
  id            String            @id @default(uuid(7)) @db.Uuid
  requirementId String?           @map("requirement_id") @db.Uuid
  packageId     String?           @map("package_id") @db.Uuid
  tutorId       String            @map("tutor_id") @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  initiatedBy   InitiatedBy       @map("initiated_by")
  status        ApplicationStatus @default(PENDING)
  appliedAt     DateTime          @default(now()) @map("applied_at") @db.Timestamptz(3)
  confirmedAt   DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  endedAt       DateTime?         @map("ended_at") @db.Timestamptz(3)
  matchScore    Int?              @map("match_score") @db.SmallInt // 0..100, written at apply time
  matchVersion  Int?              @map("match_version") @db.SmallInt
  matchParts    Json?             @map("match_parts") // component breakdown at decision time

  requirement   TuitionRequirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  package       TuitionPackage?     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  tutor         Tutor               @relation(fields: [tutorId], references: [id])
  student       Student             @relation(fields: [studentId], references: [id])
  fees          PlatformFee[]
  notifications NotificationLog[]
  alerts        AppNotification[]
  reports       Report[]
  disputes      Dispute[]

  @@unique([tutorId, requirementId]) // same tutor cannot apply to the same requirement twice
  @@unique([studentId, packageId]) // same student cannot request the same package twice
  @@index([tutorId, status, appliedAt(sort: Desc)])
  @@index([studentId, status, appliedAt(sort: Desc)])
  @@index([requirementId])
  @@index([packageId])
  @@map("application")
}

// Given between a tutor and a student, in either direction. One per direction
// per pair, and only once the pair has a CONFIRMED / COMPLETED application.
// Rating averages on tutor and student are recomputed by trigger on every
// insert, update or delete here, so they cannot drift from the rows.
model Review {
  id        String          @id @default(uuid(7)) @db.Uuid
  tutorId   String          @map("tutor_id") @db.Uuid
  studentId String          @map("student_id") @db.Uuid
  direction ReviewDirection
  rating    Int             @db.SmallInt
  comment   String?
  status    ReviewStatus    @default(VISIBLE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutor   Tutor   @relation("ReviewTutor", fields: [tutorId], references: [id])
  student Student @relation("ReviewStudent", fields: [studentId], references: [id])

  @@unique([tutorId, studentId, direction])
  @@index([tutorId, direction, status])
  @@index([studentId, direction, status])
  @@map("review")
}

// ───────────────────────── trust & safety ─────────────────────────

// A complaint about a user's conduct.
model Report {
  id              String         @id @default(uuid(7)) @db.Uuid
  reporterId      String         @map("reporter_id") @db.Uuid
  targetAccountId String         @map("target_account_id") @db.Uuid
  applicationId   String?        @map("application_id") @db.Uuid
  category        ReportCategory
  details         String
  status          CaseStatus     @default(OPEN)
  handledById     String?        @map("handled_by") @db.Uuid
  resolutionNote  String?        @map("resolution_note")
  resolvedAt      DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter    Account      @relation("ReportReporter", fields: [reporterId], references: [id])
  target      Account      @relation("ReportTarget", fields: [targetAccountId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  handledBy   AdminUser?   @relation(fields: [handledById], references: [accountId], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([targetAccountId])
  @@index([reporterId])
  @@map("report")
}

// A problem inside a running match (no-show, quality, payment).
model Dispute {
  id             String      @id @default(uuid(7)) @db.Uuid
  applicationId  String      @map("application_id") @db.Uuid
  raisedById     String      @map("raised_by") @db.Uuid
  againstId      String      @map("against") @db.Uuid
  type           DisputeType
  details        String
  status         CaseStatus  @default(OPEN)
  handledById    String?     @map("handled_by") @db.Uuid
  resolutionNote String?     @map("resolution_note")
  resolvedAt     DateTime?   @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id])
  raisedBy    Account     @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  against     Account     @relation("DisputeAgainst", fields: [againstId], references: [id])
  handledBy   AdminUser?  @relation(fields: [handledById], references: [accountId], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([applicationId])
  @@index([raisedById, createdAt(sort: Desc)], map: "dispute_raised_by_idx")
  @@map("dispute")
}

// ───────────────────────── tutor payment tracking (off-app) ─────────────────────────
// The app does not move money. It records what each tutor owes and what the
// admin received. amount_paid and status are written by a trigger from the
// fee_payment rows in the same transaction, so they cannot drift.
// tutor_id must equal application.tutor_id (platform_fee_guard trigger).

model PlatformFee {
  id            String    @id @default(uuid(7)) @db.Uuid
  tutorId       String    @map("tutor_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  feeType       FeeType   @default(PLACEMENT) @map("fee_type")
  amountDue     Decimal   @map("amount_due") @db.Decimal(12, 2)
  amountPaid    Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  dueDate       DateTime  @map("due_date") @db.Date
  status        FeeStatus @default(DUE)
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutor            Tutor             @relation(fields: [tutorId], references: [id])
  application      Application       @relation(fields: [applicationId], references: [id])
  payments         FeePayment[]
  attempts         PaymentAttempt[]
  promoRedemptions PromoRedemption[]
  refunds          PaymentRefund[]

  @@index([tutorId, status, dueDate])
  @@index([status, dueDate]) // overdue report
  @@index([applicationId])
  @@map("platform_fee")
}

// Append-only ledger. A wrong entry or a refund is a REVERSAL row pointing at
// the original payment, never an edit or delete.
// Admin-recorded rows (CASH, bKash, ...) have a recorder. Gateway rows (SSLCOMMERZ) have none:
// recorded_by is NULL, and fee_payment_recorder_required in constraints.sql enforces that.
model FeePayment {
  id                String        @id @default(uuid(7)) @db.Uuid
  feeId             String        @map("fee_id") @db.Uuid
  kind              PaymentKind   @default(PAYMENT)
  reversesPaymentId String?       @map("reverses_payment_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2) // always positive
  method            PaymentMethod
  txnReference      String?       @map("txn_reference") // bKash/Nagad TrxID etc.
  reason            String? // required for a REVERSAL
  receivedAt        DateTime      @map("received_at") @db.Timestamptz(3)
  recordedById      String?       @map("recorded_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  fee             PlatformFee     @relation(fields: [feeId], references: [id])
  recordedBy      AdminUser?      @relation(fields: [recordedById], references: [accountId], onDelete: Restrict)
  reversesPayment FeePayment?     @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversals       FeePayment[]    @relation("PaymentReversal")
  attempt         PaymentAttempt?
  refunds         PaymentRefund[] @relation("RefundPayment")
  refundReversal  PaymentRefund?  @relation("RefundReversal")

  @@index([feeId])
  @@index([reversesPaymentId])
  @@map("fee_payment")
}

// One SSLCommerz checkout for a placement fee. Created PENDING before the gateway call;
// a ledger row (fee_payment) exists only once a verified success moves it to SUCCEEDED.
// tran_id is our reference (1..30 chars). total_amount = fee_amount + charge_amount.
// The gateway charge is paid by the tutor and is not recorded in the ledger.
model PaymentAttempt {
  id              String               @id @default(uuid(7)) @db.Uuid
  feeId           String               @map("fee_id") @db.Uuid
  tutorId         String               @map("tutor_id") @db.Uuid
  tranId          String               @unique @map("tran_id")
  feeAmount       Decimal              @map("fee_amount") @db.Decimal(12, 2)
  chargeAmount    Decimal              @default(0) @map("charge_amount") @db.Decimal(12, 2)
  totalAmount     Decimal              @map("total_amount") @db.Decimal(12, 2)
  status          PaymentAttemptStatus @default(PENDING)
  sessionKey      String?              @map("session_key")
  valId           String?              @map("val_id")
  bankTranId      String?              @map("bank_tran_id")
  cardType        String?              @map("card_type")
  riskLevel       Int?                 @map("risk_level") @db.SmallInt
  failureReason   String?              @map("failure_reason")
  gatewayResponse Json?                @map("gateway_response")
  paymentId       String?              @unique @map("payment_id") @db.Uuid
  lastCheckedAt   DateTime?            @map("last_checked_at") @db.Timestamptz(3)
  settledAt       DateTime?            @map("settled_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  fee     PlatformFee     @relation(fields: [feeId], references: [id])
  tutor   Tutor           @relation(fields: [tutorId], references: [id])
  payment FeePayment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refunds PaymentRefund[]

  // At most one PENDING attempt per fee is a partial unique index in constraints.sql.
  @@index([feeId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payment_attempt")
}

// A refund of (part of) one SSLCommerz attempt's fee part. The processing charge is never refunded.
// payment_id is the attempt's ledger row (null for UNAPPLIED attempts, which never reached the ledger).
// reversal_id is the REVERSAL row written when the gateway confirms. At most one open refund
// (REQUESTED, PROCESSING, NEEDS_REVIEW) per attempt: a partial unique index in constraints.sql.
model PaymentRefund {
  id              String       @id @default(uuid(7)) @db.Uuid
  attemptId       String       @map("attempt_id") @db.Uuid
  feeId           String       @map("fee_id") @db.Uuid
  tutorId         String       @map("tutor_id") @db.Uuid
  paymentId       String?      @map("payment_id") @db.Uuid
  amount          Decimal      @db.Decimal(12, 2)
  reason          String
  source          RefundSource
  status          RefundStatus @default(REQUESTED)
  requestedById   String       @map("requested_by") @db.Uuid // account id of the tutor or admin
  decidedById     String?      @map("decided_by") @db.Uuid
  decidedAt       DateTime?    @map("decided_at") @db.Timestamptz(3)
  decisionNote    String?      @map("decision_note")
  refundRefId     String?      @map("refund_ref_id") // the gateway's refund reference
  failureReason   String?      @map("failure_reason")
  gatewayResponse Json?        @map("gateway_response")
  reversalId      String?      @unique @map("reversal_id") @db.Uuid
  lastCheckedAt   DateTime?    @map("last_checked_at") @db.Timestamptz(3)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempt     PaymentAttempt @relation(fields: [attemptId], references: [id])
  fee         PlatformFee    @relation(fields: [feeId], references: [id])
  tutor       Tutor          @relation(fields: [tutorId], references: [id])
  payment     FeePayment?    @relation("RefundPayment", fields: [paymentId], references: [id], onDelete: Restrict)
  reversal    FeePayment?    @relation("RefundReversal", fields: [reversalId], references: [id], onDelete: Restrict)
  requestedBy Account        @relation(fields: [requestedById], references: [id])
  decidedBy   AdminUser?     @relation(fields: [decidedById], references: [accountId], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([feeId, createdAt(sort: Desc)])
  @@index([attemptId])
  @@map("payment_refund")
}

// One phone verification code. Only an HMAC of the code is stored. TTL, attempts, cooldown and send caps live in the
// service; the phone format and attempt range are CHECKs in constraints.sql.
model PhoneOtp {
  id                String    @id @default(uuid(7)) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  phoneNumber       String    @map("phone_number")
  codeHash          String    @map("code_hash")
  attempts          Int       @default(0) @db.SmallInt // 0..5, CHECK in constraints.sql
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(3)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(3)
  providerRequestId String?   @map("provider_request_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, phoneNumber, createdAt])
  @@index([phoneNumber, createdAt])
  @@map("phone_otp")
}

// A discount code a super admin creates for tutor fees. Discount terms never change after creation.
// Table rules (code format, value ranges, window) live in prisma/constraints.sql.
model PromoCode {
  id             String            @id @default(uuid(7)) @db.Uuid
  code           String            @unique // stored uppercase
  description    String?
  discountType   PromoDiscountType @map("discount_type")
  discountValue  Decimal           @map("discount_value") @db.Decimal(12, 2) // percent (0-100] or taka
  maxDiscount    Decimal?          @map("max_discount") @db.Decimal(12, 2) // cap for PERCENT codes
  startsAt       DateTime?         @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?         @map("ends_at") @db.Timestamptz(3)
  maxRedemptions Int?              @map("max_redemptions") // across all tutors; null = no limit
  maxPerTutor    Int               @default(1) @map("max_per_tutor")
  isActive       Boolean           @default(true) @map("is_active")
  createdById    String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   AdminUser         @relation(fields: [createdById], references: [accountId], onDelete: Restrict)
  redemptions PromoRedemption[]

  @@index([isActive, createdAt(sort: Desc)])
  @@map("promo_code")
}

// One code applied to one fee. original_amount is the fee's amount_due before the discount.
// At most one ACTIVE redemption per fee is a partial unique index in constraints.sql.
model PromoRedemption {
  id             String                @id @default(uuid(7)) @db.Uuid
  promoId        String                @map("promo_id") @db.Uuid
  feeId          String                @map("fee_id") @db.Uuid
  tutorId        String                @map("tutor_id") @db.Uuid
  originalAmount Decimal               @map("original_amount") @db.Decimal(12, 2)
  discountAmount Decimal               @map("discount_amount") @db.Decimal(12, 2)
  status         PromoRedemptionStatus @default(ACTIVE)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt     DateTime?             @map("released_at") @db.Timestamptz(3)
  releaseReason  String?               @map("release_reason")

  promo PromoCode   @relation(fields: [promoId], references: [id])
  fee   PlatformFee @relation(fields: [feeId], references: [id])
  tutor Tutor       @relation(fields: [tutorId], references: [id])

  @@index([promoId, status])
  @@index([tutorId, promoId])
  @@index([feeId])
  @@map("promo_redemption")
}

// ───────────────────────── notifications (outbox) ─────────────────────────
// Inserted in the same transaction as the business change. A worker claims
// PENDING / FAILED / expired-SENDING rows (FOR UPDATE SKIP LOCKED), sets
// status = SENDING and next_attempt_at = now() + lease, then pushes to n8n.
// A crashed worker's row becomes claimable again when the lease runs out.
// dedupe_key is the idempotency guard, e.g. "application_confirmed:{appId}:{accountId}".

model NotificationLog {
  id                String              @id @default(uuid(7)) @db.Uuid
  eventType         NotificationEvent   @map("event_type")
  channel           NotificationChannel @default(WHATSAPP)
  recipientId       String              @map("recipient_account_id") @db.Uuid
  applicationId     String?             @map("application_id") @db.Uuid
  dedupeKey         String              @unique @map("dedupe_key")
  templateName      String              @map("template_name")
  payload           Json
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  providerMessageId String?             @unique @map("provider_message_id")
  lastError         String?             @map("last_error")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient   Account      @relation(fields: [recipientId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([recipientId])
  @@map("notification_log")
}

// ───────────────────────── in-app alerts ─────────────────────────
// One row per application event the other party should look at. Written in the
// same transaction as the status change. Names are joined at read time, so a
// rename shows everywhere. read_at null = unread.

// Application kinds carry application_id; upload kinds have none (CHECK app_notification_application_shape).
model AppNotification {
  id              String              @id @default(uuid(7)) @db.Uuid
  recipientId     String              @map("recipient_account_id") @db.Uuid
  kind            AppNotificationKind
  applicationId   String?             @map("application_id") @db.Uuid
  // REQUIREMENT_INVITED only (CHECK app_notification_requirement_shape).
  requirementId   String?             @map("requirement_id") @db.Uuid
  // Upload kinds: the admin's note when it was shared with the user, else null.
  note            String?
  filePurpose     FilePurpose?        @map("file_purpose")
  blocksVideos    Boolean?            @map("blocks_videos")
  blocksDocuments Boolean?            @map("blocks_documents")
  readAt          DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient   Account             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  application Application?        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirement TuitionRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([applicationId])
  @@index([requirementId])
  @@map("app_notification")
}

// ───────────────────────── CMS and audit ─────────────────────────

model BlogPost {
  id          String     @id @default(uuid(7)) @db.Uuid
  slug        String     @unique
  title       String
  excerpt     String?
  body        String // markdown
  coverFileId String?    @map("cover_file_id") @db.Uuid
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(3)
  authorId    String     @map("author_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  author    AdminUser  @relation(fields: [authorId], references: [accountId])
  coverFile FileAsset? @relation(fields: [coverFileId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt(sort: Desc)])
  @@map("blog_post")
}

// Landing-page blocks (hero, testimonials, FAQ...) as keyed JSON.
model SiteContent {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy AdminUser? @relation(fields: [updatedById], references: [accountId], onDelete: Restrict)

  @@map("site_content")
}

// Admin-switchable platform flags and numbers. Values are validated per key by a CHECK in constraints.sql.
// Keys: require_tutor_verification (bool), require_tutor_phone_verification (bool), require_student_phone_verification (bool),
// commission_percent (0..100), gateway_charge_percent (0..10), online_payments_enabled (bool), refund_window_days (0..90).
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy AdminUser? @relation(fields: [updatedById], references: [accountId], onDelete: Restrict)

  @@map("platform_setting")
}

// Append-only (trigger in constraints.sql).
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  actorAccountId String?  @map("actor_account_id") @db.Uuid // null = system
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor Account? @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorAccountId, createdAt(sort: Desc)])
  @@map("audit_log")
}
