# Local dev (change user/password/db if needed)
DATABASE_URL="postgresql://user:password@localhost:5432/tuition_dev"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/tuition_test"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Google OAuth (frontend sends ID token; backend only verifies it)
GOOGLE_CLIENT_ID=""

# Tokens
ACCESS_TOKEN_SECRET="change-me-in-production-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_SECRET="change-me-too-min-32-chars"
REFRESH_TOKEN_TTL="30d"

# Cloudflare R2 (S3-compatible object storage)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL_PREFIX=""

# Notifications / WhatsApp (n8n)
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# Super-admin allowlist (required for seed)
SUPER_ADMIN_EMAIL_1=""
SUPER_ADMIN_EMAIL_2=""
