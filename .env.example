# Local dev (change user/password/db if needed)
DATABASE_URL="postgresql://user:password@localhost:5432/tuition_dev"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/tuition_test"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Frontend origin(s) for CORS (comma separated for multiple; dev uses origin reflection)
FRONTEND_URL="https://tution-media-mocha.vercel.app"

# Swagger UI at /docs (on by default outside production; "true" turns it on in production)
# API_DOCS="true"

# Google OAuth (frontend sends ID token; backend only verifies it)
GOOGLE_CLIENT_ID=""

# Tokens
ACCESS_TOKEN_SECRET="change-me-in-production-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_SECRET="change-me-too-min-32-chars"
REFRESH_TOKEN_TTL="30d"

# Cloudflare R2 (S3-compatible object storage)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Bucket that serves published files (approved videos, blog covers). Needs R2_PUBLIC_URL_PREFIX too.
R2_PUBLIC_BUCKET=""
R2_PUBLIC_URL_PREFIX=""

# Notifications / WhatsApp (n8n)
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# SSLCommerz (sandbox in dev)
# Keep SSLC_IS_LIVE=false outside production; the app refuses live mode unless NODE_ENV=production.
SSLC_IS_LIVE=false
# Sandbox store credentials from the SSLCommerz merchant panel.
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
# Informational only; the SDK picks the host from SSLC_IS_LIVE.
SSLC_BASE_URL=https://sandbox.sslcommerz.com
# Public base of this API (gateway callbacks; its port must be PORT) and of the web app (browser return).
# Run the API on another port than the web app, e.g. PORT=4000 next to Next.js on 3000.
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# Super-admin allowlist (required for seed)
SUPER_ADMIN_EMAIL_1=""
SUPER_ADMIN_EMAIL_2=""
